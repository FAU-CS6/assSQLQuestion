    {
      "id": "wrapAggregateExpression",
      "defaultCost": 1,
      "group": "repair",
      "en": "Add a SQL aggregate around an expression",
      "de": "Aggregatfunktion um einen Ausdruck ergänzen"
    },
    {
      "id": "unwrapAggregateExpression",
      "defaultCost": 1,
      "group": "repair",
      "en": "Remove a SQL aggregate while retaining its argument",
      "de": "Aggregatfunktion entfernen und Argument behalten"
    },
    {
      "id": "renameBoundTableAlias",
      "defaultCost": 0,
      "group": "equivalence",
