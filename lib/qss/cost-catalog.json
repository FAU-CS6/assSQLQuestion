    },
    {
      "id": "unwrapIncompleteBinaryExpression",
      "defaultCost": 1,
      "group": "repair",
      "en": "Remove a binary operator with a missing operand",
      "de": "Unvollständigen binären Operator entfernen"
    },
    {
      "id": "removeExtraneousBinaryTerm",
      "defaultCost": 1,
      "group": "repair",
      "en": "Remove an extraneous binary SQL operation and retain one operand",
