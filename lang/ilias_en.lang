ai_sea_eo_error#:#To create a question, sequence B is not allowed to be empty.

// The expandable help text for SQL.JS (SQLite) syntax
ai_sea_eo_syntax_help_title#:#Syntax information (SQLite)
ai_sea_eo_syntax_help_text#:#<p>-- In SQLite, you need to explicitly enable foreign keys<br />PRAGMA foreign_keys = ON;<br /><br />-- SQLite has some <a href="https://sqlite.org/omitted.html">unsupported SQL Features</a><br />-- In paticular, it does NOT support ALTER TABLE table ADD CONSTRAINT<br /><br />-- For a complete reference on the supported syntax, see the official documentation: <a href="https://sqlite.org/lang.html">https://sqlite.org/lang.html</a></p>

